{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/payments/mercadopago/:action",
      "destination": "/api/payments/mercadopago?action=:action"
    },
    {
      "source": "/api/payments/paypal/:action",
      "destination": "/api/payments/paypal?action=:action"
    },
    {
      "source": "/chirp/:id",
      "destination": "/chirp.html"
    },
    {
      "source": "/embed/:id",
      "destination": "/embed.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/profile/:username",
      "destination": "/u.html?username=:username"
    },
    {
      "source": "/u/:username",
      "destination": "/u.html?username=:username"
    },
    {
      "source": "/:username((?!login|signin|register|signup|shorts|stories|reset|update-password|auth|home|explore|notifications|bookmarks|profile|settings|support|messages|chirpy|legal|embed|gold|gold-return|chirp|api|assets|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/u.html?username=:username"
    }
  ]
}
